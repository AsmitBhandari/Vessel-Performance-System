# Backend Environment Variables Template

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://username:password@localhost:5432/vessel_db
DIRECT_URL=postgresql://username:password@localhost:5432/vessel_db

# CORS Settings (Comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,https://vpro.asmitlabs.me

# Supabase Authentication Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# AI Assistant LLM Provider Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
AI_API_KEY=your_gemini_or_openai_api_key_here
